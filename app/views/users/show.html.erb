<h3>ユーザー詳細</h3>

<table>
  <tr>
    <th>タイトル</th>
    <td><%= @user.title %></td>
  </tr>
  <tr>
    <th>開始日</th>
    <td><%= @user.start %></td>
  </tr>
  <tr>
    <th>終了日</th>
    <td><%= @user.end %></td>
  </tr>
  <tr>
    <th>終日</th>
    <td><% if @user.allday == true %>⚪︎
        <% else %>
        <% end %>
    </td>
  </tr>
  <tr>
      <th>スケジュールメモ</th>
      <td><%= @user.memo %></td>
    </tr>
</table>

<div>
  <ul>
    <li><%= link_to "予定一覧に戻る", :users %></li>
    <li><%= link_to "ユーザー編集", [:edit_user] %></li>
  </ul>

</div>
